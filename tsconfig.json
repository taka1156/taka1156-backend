{
  "compilerOptions": {
    "target": "es6",
    "module": "esnext",
    "esModuleInterop": true,
    "noImplicitAny": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "outDir": "dist",
    "baseUrl": ".",
    "lib": [
      "es2020",
      "dom"
    ],
    "typeRoots": [
      "node_modules/＠types",
      "src/types"
    ],
    "paths": {
      "@/*": [
        "src/*"
      ],
    }
  },
  "exclude": [
    "vite.config.ts"
  ]
}